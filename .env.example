# 서버가 구현되면 읽기 전용 내부 API를 연결합니다. 브라우저에는 노출하지 마세요.
FARM_API_BASE_URL=http://localhost:3000
FARM_AGENT_API_TOKEN=replace-with-server-side-token

# 농농이 AI: 서버 환경에만 설정하고 브라우저 코드에는 넣지 마세요.
# 공급자 선택(선택): openai, anthropic. 비우면 키가 있는 쪽(OpenAI → Anthropic 순)을 씁니다.
AI_PROVIDER=
# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 선택. 기본값 gpt-4o-mini
OPENAI_MODEL=
# 선택. 기본값 https://api.openai.com/v1
OPENAI_BASE_URL=
# 선택. 1이면 공급자 내장 웹 검색을 켭니다(기본 꺼짐, Anthropic 지원)
AI_WEB_SEARCH=
# Anthropic (Claude)
ANTHROPIC_API_KEY=
# 선택. 기본값 claude-haiku-5-5
ANTHROPIC_MODEL=
# /api/recommend·/api/agent 대화 호출 제한(선택). 0이면 해당 제한을 끕니다. 일일 제한은 한국 시간 자정에 초기화됩니다.
# 기본값: IP당 분당 15회·하루 150회, 서비스 전체 하루 3000회
RECOMMEND_LIMIT_PER_MINUTE=
RECOMMEND_LIMIT_PER_DAY=
RECOMMEND_GLOBAL_LIMIT_PER_DAY=

# PostgreSQL 및 인증/환경 설정 (운영·Preview에서는 환경별로 완전히 분리된 값을 사용)
DATABASE_URL=
# 다중 연결 pg.Pool 통합 테스트용 격리 DB (운영/Preview DB와 분리, 설정 시 test:pg-pool 실행)
TEST_DATABASE_URL=
# DB 타임아웃(ms, 선택). 0이면 끕니다. 기본값: 문장 10000, 잠금 대기 5000, 트랜잭션 유휴 15000, 단일 쿼리 15000
DB_STATEMENT_TIMEOUT_MS=
DB_LOCK_TIMEOUT_MS=
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=
DB_QUERY_TIMEOUT_MS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_ENV=development

# 객체 저장소 (Vercel Preview/Production에서는 BLOB_READ_WRITE_TOKEN, 로컬은 data/objects 기본 사용)
BLOB_READ_WRITE_TOKEN=
OBJECT_STORAGE_DIR=

# 지도 및 날씨 API 연동 (선택: 미설정 시 내장 지역 지도 및 예시 기상 안내로 동작)
KMA_WEATHER_API_KEY=
KAKAO_MAP_JS_KEY=1535434b57df672bac4c1ff9a9170589
KAKAO_REST_API_KEY=6df1354c0ce056eef6569a59e1ed90c8

# 소셜 로그인 (Better Auth OAuth — 설정된 공급자만 자동 활성화)
# 콜백 URL: <BETTER_AUTH_URL>/api/auth/callback/kakao, <BETTER_AUTH_URL>/api/auth/callback/naver
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 알림톡 (Solapi / Kakao BizMessage REST 연동)
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_API_SECRET=
KAKAO_ALIMTALK_PF_ID=
KAKAO_ALIMTALK_SENDER_PHONE=
KAKAO_ALIMTALK_TPL_RENTAL_REQUEST=
KAKAO_ALIMTALK_TPL_RENTAL_DECISION=
KAKAO_ALIMTALK_TPL_CHAT_MESSAGE=

# 공공데이터포털 (data.go.kr) — 지자체 농기계 임대사업소 정보 API
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_RENTAL_OFFICE_URL=

# 농촌진흥청 농사로 (Nongsaro) Open API
NONGSARO_API_KEY=
NONGSARO_BASE_URL=

# 농농이 실시간 음성(gpt-live-1) 및 음성 인식(선택)
# OPENAI_API_KEY가 있으면 WebRTC 실시간 음성 대화(gpt-live-1)가 활성화됩니다.
OPENAI_LIVE_MODEL=
# 선택. 기본값 noeul (한국어 자연 음성)
OPENAI_LIVE_VOICE=
# 음성 인식(STT 폴백, 선택). 비우면 OPENAI_API_KEY가 있을 때 OpenAI, 없으면 브라우저 음성 인식
# none: 서버 인식 끄기
VOICE_STT_PROVIDER=
# 선택. 기본값 gpt-4o-mini-transcribe
OPENAI_STT_MODEL=
# 음성 API 호출 제한(선택). 기본값: IP당 분당 10회·하루 100회, 전체 하루 3000회
VOICE_LIMIT_PER_MINUTE=
VOICE_LIMIT_PER_DAY=
VOICE_GLOBAL_LIMIT_PER_DAY=

# 대리 응대 작업 큐 스윕
# /api/delegation-jobs 인증 비밀(16자 이상). Vercel Cron이 Authorization: Bearer 로 보낸다. 비우면 스윕이 503으로 거부된다.
CRON_SECRET=
# 0이면 채팅 조회에 얹은 트래픽 기반 스윕(server/delegation-kick.js)을 끈다. 기본 켜짐.
DELEGATION_KICK=
# 로컬 개발 서버 스위퍼 간격(ms). 0이면 끈다. 기본 30000
DELEGATION_SWEEP_INTERVAL_MS=
