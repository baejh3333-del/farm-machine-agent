{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/agent.js": { "maxDuration": 60 },
    "api/agent-chat-reply.js": { "maxDuration": 60 },
    "api/conversations.js": { "maxDuration": 60 },
    "api/delegation-jobs.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/delegation-jobs", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/voice", "destination": "/api/agent?route=voice" }
  ]
}
